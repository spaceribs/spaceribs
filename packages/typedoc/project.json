{
  "name": "typedoc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/typedoc/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/typedoc",
        "main": "packages/typedoc/src/index.ts",
        "tsConfig": "packages/typedoc/tsconfig.lib.json",
        "assets": [
          "packages/typedoc/*.md",
          {
            "input": "./packages/typedoc/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./packages/typedoc/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./packages/typedoc",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./packages/typedoc",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "packages/typedoc/**/*.ts",
          "packages/typedoc/generators.json",
          "packages/typedoc/executors.json",
          "packages/typedoc/package.json"
        ]
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "conventional",
        "postTargets": ["typedoc:build", "typedoc:github", "typedoc:npm"]
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "${tag}",
        "notes": "${notes}"
      }
    },
    "npm": {
      "executor": "ngx-deploy-npm:deploy",
      "dependsOn": ["build"],
      "options": {
        "access": "public",
        "distFolderPath": "dist/packages/typedoc"
      }
    }
  }
}
